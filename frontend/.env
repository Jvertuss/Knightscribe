VITE_API_BASE_URL=https://knightscribe-api.onrender.com

# Jack's Flask control page on the Raspberry Pi (status, start / stop recording)
VITE_PI_BASE_URL=http://knightcribe.local:5000

# Pi camera (MJPEG). Students only see it for lectures that are live.
VITE_PI_STREAM_URL=http://knightcribe.local:5000/video

# Restart "npm run dev" after changing this file.

# AI features (chat, AI summary, AI quiz) on a backend running on this machine,
# until Render has the Gemini key. Delete this line to use Render for everything.
VITE_AI_BASE_URL=http://localhost:8000
