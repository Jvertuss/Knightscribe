# The backend + database running on this laptop (backend/start_local.sh).
# The Render one was: https://knightscribe-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Jack's Flask control page on the Raspberry Pi (status, start / stop recording)
