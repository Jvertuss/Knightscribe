# Copy this file to backend/.env and fill it in. Never commit the real .env.

# The PostgreSQL database. For the local demo database (backend/setup_local_db.sh):
#   postgresql://knightscribe:knightscribe@127.0.0.1:5432/knightscribe
# (backend/start_local.sh sets this for you), or a hosted one such as Neon.
DATABASE_URL=your_database_connection_string_here

# Google Gemini: the AI chat, lecture summaries and practice quizzes.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Whisper transcription (optional, needs: pip install -r requirements-whisper.txt)
WHISPER_MODEL=small.en
WHISPER_THREADS=4
